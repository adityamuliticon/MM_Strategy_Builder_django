{
  "info": {
    "name": "MM Strategy Builder",
    "_postman_id": "mm-strategy-builder-v1",
    "description": "All API endpoints for MM Strategy Builder Django backend.\n\n**How to use:**\n1. Set the `baseUrl` variable (default: http://127.0.0.1:8000)\n2. Run **Auth → Login** first — Postman saves the session cookie automatically\n3. All other requests will use that cookie for authentication",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"your@email.com\",\n  \"password\": \"yourpassword\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login/", "host": ["{{baseUrl}}"], "path": ["auth", "login", ""] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/auth/logout/", "host": ["{{baseUrl}}"], "path": ["auth", "logout", ""] }
          }
        }
      ]
    },
    {
      "name": "USB — Unified Strategy Builder",
      "item": [
        {
          "name": "Chat (single response)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Create a NIFTY options strategy: BUY CE ATM, 1 lot, target ₹500, SL ₹300\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/chat", "host": ["{{baseUrl}}"], "path": ["api", "chat"] }
          }
        },
        {
          "name": "Chat Stream (SSE)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Create a NIFTY options strategy: BUY CE ATM, 1 lot, target ₹500, SL ₹300\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/chat/stream", "host": ["{{baseUrl}}"], "path": ["api", "chat", "stream"] }
          }
        },
        {
          "name": "Strategy Counts",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/strategy-counts/", "host": ["{{baseUrl}}"], "path": ["api", "strategy-counts", ""] }
          }
        },
        {
          "name": "Balance",
